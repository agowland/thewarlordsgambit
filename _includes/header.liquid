<aside class="logo">
  {% if page.url == '/index.liquid' or page.url == '/' %}
    {% assign link = '/about' %}
    {% assign prompt = 'Daggerheart Compatible %}
  {% else %}
    {% assign link = '/' %}
    {% assign prompt = 'Back to Home' %}
  {% endif %}

  <a href="{{ link | prepend: site.url }}">
    <img class="gravatar" src="assets/compatible_with_DH_logos-10.png">
  </a>
  <span class="logo-prompt">{{ prompt }}</span>

</aside>